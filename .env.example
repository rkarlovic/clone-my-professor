# Copy to .env (git-ignored) and change the passwords. Used by
# infra/docker-compose.dev.yml (via --env-file .env) and by the backend.

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=cmp
# Owner/superuser: runs migrations only.
POSTGRES_USER=cmp_owner
POSTGRES_PASSWORD=change-me-owner
# Application role: NOT a superuser and NOT the table owner, so row-level
# security applies to it. Everything except migrations connects as this role.
CMP_APP_DB_USER=cmp_app
CMP_APP_DB_PASSWORD=change-me-app
POSTGRES_HOST_PORT=5432

# Backend connection strings (host-side; containers use the service name).
DATABASE_URL=postgresql+psycopg://cmp_app:change-me-app@127.0.0.1:5432/cmp
DATABASE_OWNER_URL=postgresql+psycopg://cmp_owner:change-me-owner@127.0.0.1:5432/cmp

# --- Model layer ----------------------------------------------------------
# If a native Ollama already runs on the host and holds 11434, set 11435 here
# and in OLLAMA_API_BASE.
OLLAMA_HOST_PORT=11434
OLLAMA_API_BASE=http://127.0.0.1:11434
INFINITY_HOST_PORT=7997
INFINITY_API_BASE=http://127.0.0.1:7997
# Defaults to ../config/models.yaml relative to backend/.
# CMP_MODELS_CONFIG=../config/models.yaml

# --- Sessions (build step 4) -----------------------------------------------
# Signs session tokens after an LTI launch; required unless AUTH_MODE=dev. At least 32
# random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# SESSION_SECRET=
# AUTH_MODE=dev
# PUBLIC_URL=http://127.0.0.1:5173

# --- Local Moodle (dev only, compose profile "moodle") ----------------------
MOODLE_HOST_PORT=8080
MOODLE_DB_PASSWORD=change-me-moodle-db
# Moodle's password policy: 8+ characters with a digit, a lower- and upper-case letter and a symbol.
MOODLE_ADMIN_PASSWORD=change-me-Admin-1!
# Password of the test teacher and student the setup script creates.
MOODLE_TEST_PASSWORD=change-me-Test-1!
