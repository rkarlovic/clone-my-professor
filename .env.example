# Copy to .env (git-ignored) and change the passwords. Used by
# infra/docker-compose.dev.yml (via --env-file .env) and by the backend.

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=cmp
# Owner/superuser: runs migrations only.
POSTGRES_USER=cmp_owner
POSTGRES_PASSWORD=change-me-owner
# Application role: NOT a superuser and NOT the table owner, so row-level
# security applies to it. Everything except migrations connects as this role.
CMP_APP_DB_USER=cmp_app
CMP_APP_DB_PASSWORD=change-me-app
POSTGRES_HOST_PORT=5432

# Backend connection strings (host-side; containers use the service name).
DATABASE_URL=postgresql+psycopg://cmp_app:change-me-app@127.0.0.1:5432/cmp
DATABASE_OWNER_URL=postgresql+psycopg://cmp_owner:change-me-owner@127.0.0.1:5432/cmp

# --- Model layer ----------------------------------------------------------
# If a native Ollama already runs on the host and holds 11434, set 11435 here
# and in OLLAMA_API_BASE.
OLLAMA_HOST_PORT=11434
OLLAMA_API_BASE=http://127.0.0.1:11434
INFINITY_HOST_PORT=7997
INFINITY_API_BASE=http://127.0.0.1:7997
# Defaults to ../config/models.yaml relative to backend/.
# CMP_MODELS_CONFIG=../config/models.yaml

# --- Sessions (build step 4) -----------------------------------------------
# Signs session tokens after an LTI launch; required unless AUTH_MODE=dev. At least 32
# random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# SESSION_SECRET=
# AUTH_MODE=dev
# PUBLIC_URL=http://127.0.0.1:5173

# --- Local Moodle (dev only, compose profile "moodle") ----------------------
MOODLE_HOST_PORT=8080
MOODLE_DB_PASSWORD=change-me-moodle-db
# Moodle's password policy: 8+ characters with a digit, a lower- and upper-case letter and a symbol.
MOODLE_ADMIN_PASSWORD=change-me-Admin-1!
# Password of the test teacher and student the setup script creates.
MOODLE_TEST_PASSWORD=change-me-Test-1!

# --- Retention and admin (build step 4) -------------------------------------
# RETENTION_DAYS=180
# Admin page (#/admin): at least 32 random characters; without it the admin API is closed.
# ADMIN_TOKEN=

# --- Moodle material sync ---------------------------------------------------
# Web Services token of the dev Moodle (setup_cmp.php prints it); the variable's *name* is
# registered with scripts.lti_platform ws --token-env.
# MOODLE_WS_TOKEN=

# --- Installation (infra/docker-compose.yml; setup.ps1 / setup.sh fill these in) ---
# CMP_SITE=localhost              # host name; anything but localhost gets HTTPS automatically
# CMP_SCHEME=http                 # http for localhost, https otherwise
# CMP_SITE_ADDRESS=http://localhost
# CMP_FRAME_ANCESTORS=            # LMS origins allowed to embed CMP, space-separated
# CMP_HTTP_PORT=80
# CMP_HTTPS_PORT=443
# CMP_MODELS_FILE=models.yaml     # chosen by the setup scripts from the GPU's memory: models.yaml
#                                 # (no GPU), models.vllm-8gb.yaml, models.vllm-16gb.yaml, models.vllm.yaml
# VLLM_MODEL=                     # with a GPU: serve_model from that file
# VLLM_ARGS=                      # with a GPU: serve_args from that file (vLLM start flags)
# CMP_MOODLE_PORT=8080            # the installed stack's test Moodle (--with-moodle)
# TEST_MOODLE_WS_TOKEN=           # its Web Services token (written by the setup script)

# --- Teacher sign-in with Microsoft / Google (core/sso.py) ------------------------------
# App registrations are made by the institution. Redirect URI to register:
#   <PUBLIC_URL>/api/sso/microsoft/callback  and  <PUBLIC_URL>/api/sso/google/callback
# A provider is offered only when limited to the institution (tenant id / Workspace domain /
# allowed e-mail domains).
# SSO_MICROSOFT_CLIENT_ID=
# SSO_MICROSOFT_CLIENT_SECRET=
# SSO_MICROSOFT_TENANT=            # the tenant id (not "organizations") or set SSO_ALLOWED_DOMAINS
# SSO_GOOGLE_CLIENT_ID=
# SSO_GOOGLE_CLIENT_SECRET=
# SSO_GOOGLE_HOSTED_DOMAIN=        # the Workspace domain, e.g. skola.hr
# SSO_ALLOWED_DOMAINS=             # comma-separated e-mail domains

# --- Chat --------------------------------------------------------------------------------
# CHAT_QUESTIONS_PER_HOUR=30       # per student per course; 0 = no limit

# --- Teams / Google Classroom material sync (secrets; their *names* go to the platform) ------
# CMP_TEAMS_SECRET=                # the Entra app's client secret
# CMP_GOOGLE_SA_KEY=               # the service account key: JSON, or a path to the file

# --- Tracing (infra/docker-compose.langfuse.yml; the setup scripts' tracing switch fills these)
# LANGFUSE_HOST=http://127.0.0.1:3000   # for the backend on the host (containers set their own)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_DB_PASSWORD= LANGFUSE_SALT= LANGFUSE_ENCRYPTION_KEY= (64 hex) LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_CLICKHOUSE_PASSWORD= LANGFUSE_MINIO_PASSWORD= LANGFUSE_REDIS_PASSWORD=
# LANGFUSE_ADMIN_PASSWORD=         # LANGFUSE_ADMIN_EMAIL defaults to admin@cmp.local
# LANGFUSE_PORT=3000

# --- Teams tab app (for schools without LTI in Teams; scripts.teams_app builds the package) ---
# TEAMS_APP_CLIENT_ID=             # the Entra app Teams single sign-on issues tokens for
# TEAMS_APP_ID_URI=                # default api://<host>/<client id> ("Expose an API")
